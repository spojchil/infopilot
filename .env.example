# ===== 数据库（PostgreSQL + PGVector 同库） =====
DB_URL=jdbc:postgresql://postgres:5432/infopilot
DB_USERNAME=infopilot
DB_PASSWORD=change-me

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 对话模型（OpenAI 兼容接口） =====
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_API_KEY=sk-your-key
CHAT_MODEL=deepseek-chat

# ===== 嵌入模型（文档向量化） =====
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embedding-3

# ===== PGVector 向量存储 =====
VECTOR_STORE_HOST=postgres
VECTOR_STORE_PORT=5432
VECTOR_STORE_DATABASE=infopilot
# 用户名密码复用 DB_USERNAME / DB_PASSWORD

# ===== 服务 =====
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
